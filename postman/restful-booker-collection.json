          "name": "NEG-01 Auth wrong password",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status is 401 or 403 for bad credentials\", function () {\r",
                  "    pm.expect(pm.response.code).to.be.oneOf([401, 403]);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"No token is returned\", function () {\r",
                  "    pm.expect(pm.response.text()).to.not.include(\"token\");\r",
                  "});"
